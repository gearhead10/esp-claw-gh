menu "ESP-Claw Core"

choice CLAW_CORE_STAGE_VERBOSITY
    prompt "Agent stage notification verbosity"
    default CLAW_CORE_STAGE_VERBOSITY_SIMPLE
    help
        Controls how much detail is forwarded to IM channels during agent execution.

config CLAW_CORE_STAGE_VERBOSITY_SIMPLE
    bool "Simple"
    help
        Send only essential updates: tool names being invoked.

config CLAW_CORE_STAGE_VERBOSITY_VERBOSE
    bool "Verbose"
    help
        Include tool arguments preview and iteration round in addition to tool
        names. Useful for debugging and power users.

endchoice

config CLAW_CORE_STRIP_THINK_TAGS
    bool "Strip <think>...</think> blocks from user-facing responses"
    default y
    help
        When the LLM emits inline reasoning tags (DeepSeek R1, Qwen3 reasoning,
        local backends without structured separation), strip them from the final
        text before delivering to Web IM, Telegram, QQ, MCP server, etc.
        Reasoning that comes through the structured 'reasoning_content' field
        is unaffected by this option.

endmenu
